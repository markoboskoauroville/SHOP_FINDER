#!/data/data/com.termux/files/usr/bin/bash
# mapool  --  the one word that runs the Shop & Pool Finder on the phone (Marko, 13.9.2026: "mapool,
# build this as a global run command for this app"). The shape of `transcribe` and `gtt`: the plain
# word starts the server in the foreground, whose console has the keys every app here has
# (q quit, o open page, u check for update, r restart); a second word does one job and exits.
#
#   mapool             start the server and open the page (q quits it)
#   mapool update      pull the newest version from GitHub, then exit (the U key does the same, live)
#   mapool boot        start the server when the phone boots (Termux:Boot), in the background
#   mapool install     put the `mapool` command on the PATH ($PREFIX/bin and ~/.local/bin)
#   mapool where       print the folder and the version
#
# Everything Android-specific is in here; serve.py knows nothing about the platform. No cd anywhere:
# absolute paths only (a cd at the head of a command can silently not take on this phone).
set -u

# the folder this file is in, through any symlink; then spelled the way Termux and the PRoot both
# see it ($HOME/... is the same directory under both names)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
APP="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
PY="$(command -v python3 || command -v python)"
BIN="${PREFIX:-/data/data/com.termux/files/usr}/bin"
LOG="$HOME/mapool.log"

if [ -t 1 ]; then AM="\033[38;5;214m"; DIM="\033[0;90m"; BAD="\033[1;31m"; OFF="\033[0m"
else AM=""; DIM=""; BAD=""; OFF=""; fi

version() { sed -nE 's/^APP_VERSION *= *([0-9]+).*/\1/p' "$APP/version.py" 2>/dev/null; }

case "${1:-run}" in
  run|"")
    [ -n "$PY" ] || { printf "  ${BAD}no python3 on the PATH${OFF}: pkg install python\n"; exit 1; }
    # the Anthropic key for the page's refresh button (update_pools.py, Claude Haiku): the file in the
    # phone's API folder, handed over in the environment, never copied and never printed
    if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ ! -s "$APP/anthropic_key" ] && [ -s "$HOME/storage/downloads/Api/Claude_api.txt" ]; then
      ANTHROPIC_API_KEY="$(grep -oE 'sk-ant-[A-Za-z0-9_-]{20,}' "$HOME/storage/downloads/Api/Claude_api.txt" | tail -1)"
      [ -n "$ANTHROPIC_API_KEY" ] && export ANTHROPIC_API_KEY
    fi
    termux-wake-lock 2>/dev/null || true
    exec "$PY" "$APP/serve.py"
    ;;
  update)
    printf "\n  ${AM}mapool update${OFF}  installed v$(version)\n"
    [ -d "$APP/.git" ] || { printf "  ${BAD}$APP is not a git clone${OFF}, clone it from GitHub instead\n\n"; exit 1; }
    git -C "$APP" fetch --quiet origin main || { printf "  ${BAD}could not reach GitHub${OFF}, nothing changed\n\n"; exit 1; }
    if [ "$(git -C "$APP" rev-parse @)" = "$(git -C "$APP" rev-parse origin/main)" ]; then
      printf "  already the latest (v$(version)), nothing to do\n\n"; exit 0
    fi
    git -C "$APP" pull --ff-only origin main || { printf "  ${BAD}git pull failed${OFF}, nothing changed\n\n"; exit 1; }
    printf "  ${AM}updated to v$(version)${OFF}; run  mapool  again\n\n"
    ;;
  boot)
    mkdir -p "$HOME/.termux/boot"
    NEW="$HOME/.termux/boot/mapool.sh.new"
    cat > "$NEW" <<BOOTEOF
#!/data/data/com.termux/files/usr/bin/sh
# written by mapool boot: the Shop & Pool Finder at boot, no console (no terminal), log in ~/mapool.log
termux-wake-lock
test -d "\$HOME/storage" || termux-setup-storage
sleep 5
exec "$PY" "$APP/serve.py" >> "$LOG" 2>&1
BOOTEOF
    chmod +x "$NEW" && mv -f "$NEW" "$HOME/.termux/boot/mapool.sh"
    printf "  boot autostart installed: ~/.termux/boot/mapool.sh (needs the Termux:Boot app); log: $LOG\n"
    ;;
  install)
    # a wrapper on the PATH, not a symlink: this folder is on the sdcard, which Android mounts without
    # execute permission, so a symlinked script would not run; `bash <file>` does. Written beside its
    # name and renamed over it (never truncated: a running copy of the old one keeps its file).
    for d in "$BIN" "$HOME/.local/bin"; do
      mkdir -p "$d" 2>/dev/null || continue
      printf '#!/data/data/com.termux/files/usr/bin/bash\nexec bash "%s/mapool" "$@"\n' "$APP" > "$d/mapool.new" && chmod +x "$d/mapool.new" && mv -f "$d/mapool.new" "$d/mapool" \
        && printf "  ${AM}mapool${OFF} -> $d/mapool\n"
    done
    printf "  ${DIM}type  mapool  anywhere to start; mapool update, mapool boot${OFF}\n"
    ;;
  where)
    printf "  %s   v%s\n" "$APP" "$(version)"
    ;;
  *)
    printf "  mapool [run|update|boot|install|where]\n"; exit 2
    ;;
esac
